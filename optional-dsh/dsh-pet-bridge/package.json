{
  "name": "@local/dsh-pet-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Writes DSH agent activity to a state file so a desktop pet can react to it.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
